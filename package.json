{
  "name": "serverless-certificate-creator",
  "version": "2.0.0",
  "description": "creates a certificate that can be used for custom domains for your api gateway",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "author": "schwamster",
  "license": "MIT",
  "dependencies": {
    "aws-sdk": "^2.1692.0",
    "chalk": "^4.1.2",
    "delay": "^5.0.0",
    "mkdirp": "^1.0.4",
    "semver": "^7.7.3",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/examples/"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-results/junit",
          "outputName": "results.xml",
          "suiteName": "serverless-certificate-creator tests"
        }
      ]
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schwamster/serverless-certificate-creator.git"
  },
  "bugs": {
    "url": "https://github.com/schwamster/serverless-certificate-creator/issues"
  },
  "homepage": "https://github.com/schwamster/serverless-certificate-creator#readme"
}
